# Server
ENV=development
PORT=8080
LOG_LEVEL=info
LOG_FORMAT=json

# PostgreSQL (required)
DATABASE_URL=postgres://clinic:clinic@localhost:5432/clinic?sslmode=disable

# Cache & messaging
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222

# Connection bootstrap: shared context + timeout + retry per dependency.
# Each set is: TIMEOUT per attempt, ATTEMPTS total, BACKOFF initial (doubles).
DB_CONNECT_TIMEOUT=5s
DB_CONNECT_ATTEMPTS=5
DB_CONNECT_BACKOFF=500ms
REDIS_CONNECT_TIMEOUT=5s
REDIS_CONNECT_ATTEMPTS=5
REDIS_CONNECT_BACKOFF=500ms
NATS_CONNECT_TIMEOUT=5s
NATS_CONNECT_ATTEMPTS=5
NATS_CONNECT_BACKOFF=500ms

# Auth (required) — generate with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h

# Security tuning
BCRYPT_COST=12
RATE_LIMIT_PER_MINUTE=60

# Domain behavior
IDEMPOTENCY_TTL=24h

# HTTP timeouts
READ_TIMEOUT=10s
WRITE_TIMEOUT=10s
IDLE_TIMEOUT=120s
SHUTDOWN_PERIOD=30s
